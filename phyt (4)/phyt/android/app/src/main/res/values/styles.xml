<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <!-- Dark theme matching InfraSense AI -->
        <item name="colorPrimary">#030408</item>
        <item name="colorPrimaryDark">#030408</item>
        <item name="colorAccent">#00f0ff</item>
        <item name="android:navigationBarColor">#030408</item>
        <item name="android:statusBarColor">#030408</item>
        <item name="android:windowBackground">#030408</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">#030408</item>
        <item name="android:navigationBarColor">#030408</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>